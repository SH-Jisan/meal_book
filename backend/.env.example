# =================================================================
# MEAL BOOK BACKEND ENVIRONMENT TEMPLATE
# =================================================================

PORT=3000
NODE_ENV="development"
DATABASE_URL="postgresql://user:password@localhost:5432/meal_book?schema=public"

# JWT Authentication (Required by env.validation.ts)
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key"
JWT_REFRESH_EXPIRATION="7d"

# Redis Cache & BullMQ Queues
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS="false"

# Optional Failover Redis (Primary/Secondary)
# REDIS_HOST_1=""
# REDIS_PORT_1=6379
# REDIS_PASSWORD_1=""
# REDIS_TLS_1="true"
# REDIS_HOST_2=""
# REDIS_PORT_2=6379
# REDIS_PASSWORD_2=""
# REDIS_TLS_2="true"

# =================================================================
# TRIPLE AI CASCADING AUTO-FAILOVER ENGINE CONFIGURATION
# =================================================================

# 1. Primary AI (Default - Highest Performance): Groq Cloud LPU
# Free API key at: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# 2. Secondary AI (Backup 1 - High Accuracy): Google Gemini
# Free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# 3. Tertiary AI (Backup 2 - Universal Free Aggregator): OpenRouter
# Free API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="liquid/lfm-2.5-2.6b:free"
