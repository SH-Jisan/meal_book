PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/meal_book"
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"

# Redis Cache & Queues
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ==========================================
# TRIPLE AI ENGINES (CASCADING AUTO-FAILOVER)
# ==========================================
# 1. Primary AI: Google Gemini (Free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# 2. Secondary AI: Groq Cloud (Free at https://console.groq.com/keys)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# 3. Tertiary AI: OpenRouter (Free at https://openrouter.ai/keys)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
